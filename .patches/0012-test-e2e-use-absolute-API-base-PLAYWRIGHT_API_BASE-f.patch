From f799b02bbe4a068335c24745d8e77e526dda8e50 Mon Sep 17 00:00:00 2001
From: Your Name <your.email@example.com>
Date: Sun, 16 Nov 2025 22:27:20 +0100
Subject: [PATCH 12/20] test(e2e): use absolute API base (PLAYWRIGHT_API_BASE)
 for presign and PDF tests; update test:dev to export API base to runner

---
 apps/e2e/package.json                          |  2 +-
 apps/e2e/tests/projects/pdf-report.spec.ts     | 14 ++++++++------
 apps/e2e/tests/projects/presign-export.spec.ts |  3 ++-
 3 files changed, 11 insertions(+), 8 deletions(-)

diff --git a/apps/e2e/package.json b/apps/e2e/package.json
index 410204e..fbdb7a8 100644
--- a/apps/e2e/package.json
+++ b/apps/e2e/package.json
@@ -7,7 +7,7 @@
     "report": "playwright show-report",
     "test": "playwright test --max-failures=1",
     "test:ui": "playwright test --ui",
-    "test:dev": "cross-env PLAYWRIGHT_SERVER_COMMAND=\"cross-env NEXT_PUBLIC_API_BASE_URL=http://localhost:8000 NEXT_PUBLIC_DISABLE_AUTH=true pnpm --filter web dev\" playwright test"
+    "test:dev": "cross-env NEXT_PUBLIC_API_BASE_URL=http://localhost:8000 PLAYWRIGHT_API_BASE=http://localhost:8000 PLAYWRIGHT_SERVER_COMMAND=\"cross-env NEXT_PUBLIC_API_BASE_URL=http://localhost:8000 NEXT_PUBLIC_DISABLE_AUTH=true pnpm --filter web dev\" playwright test"
   },
   "keywords": [],
   "author": "",
diff --git a/apps/e2e/tests/projects/pdf-report.spec.ts b/apps/e2e/tests/projects/pdf-report.spec.ts
index 85267d9..fc8a0b9 100644
--- a/apps/e2e/tests/projects/pdf-report.spec.ts
+++ b/apps/e2e/tests/projects/pdf-report.spec.ts
@@ -2,9 +2,10 @@ import { test, expect } from '@playwright/test';
 
 // Ensures a run exists (via UI generation if needed), then fetches its PDF report.
 
-async function ensureRun(page: any): Promise<string> {
+async function ensureRun(page: any, request: any): Promise<string> {
   // Try existing runs first
-  const existing = await page.request.get('/api/v1/runs');
+  const base = process.env.PLAYWRIGHT_API_BASE || process.env.NEXT_PUBLIC_API_BASE_URL || 'http://127.0.0.1:8001';
+  const existing = await request.get(`${base}/api/v1/runs`);
   if (existing.ok()) {
     const runs = await existing.json();
     if (Array.isArray(runs) && runs.length) {
@@ -18,16 +19,17 @@ async function ensureRun(page: any): Promise<string> {
   await page.getByTestId('generate-run-btn').click();
   await page.waitForURL(/\/projects\/.+\/results$/, { timeout: 120000 });
   // Fetch runs again
-  const after = await page.request.get('/api/v1/runs');
+  const after = await request.get(`${base}/api/v1/runs`);
   expect(after.ok()).toBeTruthy();
   const runs2 = await after.json();
   expect(Array.isArray(runs2) && runs2.length).toBeTruthy();
   return runs2[0].run_id || runs2[0].id;
 }
 
-test('pdf report retrieval', async ({ page }) => {
-  const runId = await ensureRun(page);
-  const resp = await page.request.get(`/api/v1/runs/${runId}/report.pdf`);
+test('pdf report retrieval', async ({ page, request }) => {
+  const base = process.env.PLAYWRIGHT_API_BASE || process.env.NEXT_PUBLIC_API_BASE_URL || 'http://127.0.0.1:8001';
+  const runId = await ensureRun(page, request);
+  const resp = await request.get(`${base}/api/v1/runs/${runId}/report.pdf`);
   expect(resp.ok()).toBeTruthy();
   const ct = resp.headers()['content-type'] || resp.headers()['Content-Type'];
   expect(ct).toMatch(/application\/pdf/);
diff --git a/apps/e2e/tests/projects/presign-export.spec.ts b/apps/e2e/tests/projects/presign-export.spec.ts
index 9b93aef..95953dd 100644
--- a/apps/e2e/tests/projects/presign-export.spec.ts
+++ b/apps/e2e/tests/projects/presign-export.spec.ts
@@ -3,7 +3,8 @@ import { test, expect } from '@playwright/test';
 // Directly calls the presign export endpoint and validates structure.
 
 test('presign export endpoint', async ({ request }) => {
-  const resp = await request.post('/api/v1/exports/presign', {
+  const base = process.env.PLAYWRIGHT_API_BASE || process.env.NEXT_PUBLIC_API_BASE_URL || 'http://127.0.0.1:8001';
+  const resp = await request.post(`${base}/api/v1/exports/presign`, {
     data: { run_id: 'run-e2e', kind: 'pdf' },
   });
   expect(resp.ok()).toBeTruthy();
