{
  "title": "Makerkit DfX & Runs",
  "panels": [
    {"type": "stat", "title": "Runs Completed %", "targets": [{"expr": "(sum(api_requests_total{status='200',path='/api/v1/runs'}) / sum(api_requests_total{path='/api/v1/runs'})) * 100"}]},
    {"type": "graph", "title": "Request Duration (p95 approx)", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(api_request_duration_seconds_bucket[5m])) by (le))"}]},
    {"type": "graph", "title": "Requests per Path", "targets": [{"expr": "sum(rate(api_requests_total[5m])) by (path)"}]},
    {"type": "stat", "title": "TopOpt Executions", "targets": [{"expr": "sum(api_requests_total{path='/api/v1/topopt/optimize'})"}]}
  ],
  "schemaVersion": 38,
  "version": 1
}
