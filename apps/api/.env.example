# API .env example (copy to .env and fill values)

# Supabase (required for real runs/variants)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Service role key (required for seeding/admin endpoints; keep server-side only)
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
# Public anon key (front-end usage). Do NOT use this for seeding.
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_STORAGE_BUCKET=artifacts

# LLM provider
# Option A: Local free Ollama (preferred for dev)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:7b-instruct

# Option B: Mistral Cloud
# MISTRAL_API_KEY=sk-...
# MISTRAL_API_BASE=https://api.mistral.ai
# MISTRAL_MODEL=mistral-small-latest

# Env loader (set to 1 to auto-load .env at startup)
# LOAD_DOTENV=1

# Optional external image diffusion endpoint (returns { image_b64 })
# DIFFUSION_IMAGE_URL=http://localhost:9000/generate

# --- Real image generation (recommended) ---
# Uses Hugging Face Inference via `huggingface_hub.InferenceClient`.
# Required to avoid stub/placeholder images in production.
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Provide ONE of the following tokens (preferred: HF_TOKEN)
HF_TOKEN=hf_...
# HUGGINGFACE_API_KEY=hf_...
# HUGGINGFACE_HUB_TOKEN=hf_...
# Provider used by InferenceClient (defaults to hf-inference)
HF_IMAGE_PROVIDER=hf-inference
# Timeout (seconds) for HF calls
HF_IMAGE_TIMEOUT=30

# If enabled, the API will return 503 instead of fake/stub images.
# Turn this on for staging/prod.
REQUIRE_REAL_IMAGES=1

# Optional local diffusers backend (GPU recommended). Off by default.
LOCAL_DIFFUSERS_ENABLED=0
LOCAL_DIFFUSERS_CPU=0
# SD_MODEL=runwayml/stable-diffusion-v1-5

# Pipelines toggles
CAD_ENABLED=0
FEM_ENABLED=0

# Background processing
CELERY_ENABLED=0

# Testing shortcuts
TEST_MODE=
