{
  "info": {
    "name": "Makerkit API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Minimal collection for Makerkit FastAPI endpoints"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/health",
          "protocol": "http",
          "host": ["127","0","0","1"],
          "port": "8000",
          "path": ["health"]
        }
      }
    },
    {
      "name": "Create Run",
      "request": {
        "method": "POST",
        "header": [
          {"key":"Content-Type","value":"application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_id\": \"uuid-1234\",\n  \"input_mode\": \"sketch\",\n  \"description\": \"support mural pour enceinte compacte, charge 5 kg\",\n  \"constraints\": {\n    \"material\": \"PLA\",\n    \"max_weight\": 5.0,\n    \"mounting_points\": 2\n  },\n  \"options\": {\n    \"generate_3d\": true,\n    \"fem\": true,\n    \"dfx_aspects\": [\"DFM\", \"DFA\"]\n  }\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/runs",
          "protocol": "http",
          "host": ["127","0","0","1"],
          "port": "8000",
          "path": ["api","v1","runs"]
        }
      }
    },
    {
      "name": "List Runs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/runs",
          "protocol": "http",
          "host": ["127","0","0","1"],
          "port": "8000",
          "path": ["api","v1","runs"]
        }
      }
    },
    {
      "name": "Get Run",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/runs/{{run_id}}",
          "protocol": "http",
          "host": ["127","0","0","1"],
          "port": "8000",
          "path": ["api","v1","runs", "{{run_id}}"]
        }
      }
    },
    {
      "name": "Run Report (PDF)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/runs/{{run_id}}/report.pdf",
          "protocol": "http",
          "host": ["127","0","0","1"],
          "port": "8000",
          "path": ["api","v1","runs", "{{run_id}}", "report.pdf"]
        }
      }
    }
  ],
  "variable": [
    {"key": "run_id", "value": "run-demo"}
  ]
}
