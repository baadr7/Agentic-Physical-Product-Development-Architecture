# Web .env example (copy to .env.local and fill values)

# Prefer keeping browser calls same-origin (Next.js route handlers under /app/api/**)
# and configure the upstream FastAPI origin server-side.
#
# - Browser: uses Next.js proxy routes (no CORS / works over LAN)
# - Server: proxies to FastAPI using API_BASE_URL
API_BASE_URL=http://127.0.0.1:8000

# Optional: force direct browser->FastAPI calls (not recommended for LAN/dev)
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Enable STL viewer (requires compatible environment)
NEXT_PUBLIC_ENABLE_STL_VIEWER=false
# Activer l'affichage glTF (Three.js) pour prototypes topologie
NEXT_PUBLIC_ENABLE_GLTF_VIEWER=false

# Supabase (required for auth in the web app)
# Copy from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Disable auth guard in middleware if not configuring Supabase yet
# Set to true for local development without Supabase
NEXT_PUBLIC_DISABLE_AUTH=false  # set true to bypass auth (dev only)

# Optional feature flags
NEXT_PUBLIC_FEATURE_IMAGE_VARIANTS=1
